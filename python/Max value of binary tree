from collections import deque

class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right 


root = TreeNode(10);
root.left = TreeNode(20);
root.right = TreeNode(50);
root.left.left = TreeNode(40);
root.left.right = TreeNode(30);
root.left.right.left = TreeNode(60);

def maximum_val_node(root):
    if root is None:
        return float('-inf')
    
    left_result = maximum_val_node(root.left)
    right_result = maximum_val_node(root.right)
    
    return max(root.val, left_result, right_result)
        
print(maximum_val_node(root))
