from collections import deque

class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right 


root = TreeNode(10);
root.left = TreeNode(20);
root.right = TreeNode(50);
root.left.left = TreeNode(40);
root.left.right = TreeNode(30);
root.left.right.left = TreeNode(60);

def search_node_value(root, target):
    if root is None:
        return False;
    
    if root.val == target:
        return True;
    
    return search_node_value(root.left, target) or search_node_value(root.right, target)
    
    
        
print(search_node_value(root, 400))
